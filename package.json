{
    "name": "psydoctor",
    "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "check:env": "node scripts/check-env.mjs",
    "prebuild": "node scripts/check-env.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
        "lint": "next lint",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "smoke:golive": "node scripts/smoke-golive.js",
        "ops:report": "node scripts/generate-phase5-daily-report.js",
        "ops:backfill:3": "node scripts/backfill-phase5-reports.js",
        "ops:weekly": "node scripts/generate-phase5-weekly-review.js",
        "ops:decisions": "node scripts/generate-phase5-weekly-decisions.js",
        "ops:baseline": "node scripts/generate-phase5-baseline.js",
        "ops:status": "node scripts/generate-phase5-progress.js",
        "ops:golive:status": "node scripts/generate-go-live-readiness.js",
        "ops:golive:status:strict": "node scripts/generate-go-live-readiness.js --strict",
        "ops:local:validate": "node scripts/run-local-validation.js",
        "ops:local:pipeline": "node scripts/run-local-pipeline.js",
        "ops:weekly:pipeline": "node scripts/run-phase5-weekly-pipeline.js",
        "ops:schedule": "powershell -ExecutionPolicy Bypass -File scripts/setup-ops-report-task.ps1",
        "ops:unschedule": "powershell -ExecutionPolicy Bypass -File scripts/remove-ops-report-task.ps1",
        "ops:weekly:schedule": "powershell -ExecutionPolicy Bypass -File scripts/setup-ops-weekly-task.ps1",
        "ops:weekly:unschedule": "powershell -ExecutionPolicy Bypass -File scripts/remove-ops-weekly-task.ps1",
        "ops:decisions:schedule": "powershell -ExecutionPolicy Bypass -File scripts/setup-ops-decisions-task.ps1",
        "ops:decisions:unschedule": "powershell -ExecutionPolicy Bypass -File scripts/remove-ops-decisions-task.ps1",
        "postinstall": "prisma generate",
        "db:push": "prisma db push",
        "db:studio": "prisma studio",
        "db:generate": "prisma generate",
        "db:seed": "node prisma/seed-run.js"
    },
    "prisma": {
        "seed": "node prisma/seed-run.js"
    },
    "dependencies": {
        "@daily-co/daily-js": "^0.87.0",
        "@daily-co/daily-react": "^0.24.0",
        "@next-auth/prisma-adapter": "^1.0.7",
        "@prisma/client": "^5.8.0",
        "@sentry/nextjs": "^10.38.0",
        "@supabase/supabase-js": "^2.95.3",
        "bcryptjs": "^2.4.3",
        "canvas-confetti": "^1.9.4",
        "clsx": "^2.1.0",
        "framer-motion": "^12.27.0",
        "jspdf": "^4.0.0",
        "jspdf-autotable": "^5.0.7",
        "lucide-react": "^0.303.0",
        "next": "^14.2.35",
        "next-auth": "^4.24.5",
        "next-intl": "^4.12.0",
        "openai": "^7.5.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "resend": "^6.7.0",
        "sharp": "^0.33.5",
        "tailwind-merge": "^2.2.0",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^6.2.0",
        "@testing-library/react": "^14.1.2",
        "@types/bcryptjs": "^2.4.6",
        "@types/canvas-confetti": "^1.9.0",
        "@types/jest": "^29.5.11",
        "@types/node": "^20.10.0",
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "autoprefixer": "^10.4.16",
        "dotenv": "^17.2.3",
        "eslint": "^8.56.0",
        "eslint-config-next": "^14.2.35",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "msw": "^2.12.10",
        "postcss": "^8.5.26",
        "prisma": "^5.8.0",
        "tailwindcss": "^3.4.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.3.0"
    },
    "overrides": {
        "postcss": "^8.5.26"
    }
}
