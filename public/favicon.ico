<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" fill="none">
  <defs>
    <linearGradient id="favEmerald" x1="20" y1="20" x2="80" y2="80" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#0F766E"/>
      <stop offset="100%" stop-color="#0D9488"/>
    </linearGradient>
    <linearGradient id="favNavy" x1="30" y1="20" x2="70" y2="85" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#0F172A"/>
      <stop offset="100%" stop-color="#1E3A5F"/>
    </linearGradient>
  </defs>

  <rect width="100" height="100" rx="28" fill="#F8FAFC"/>
  <rect x="2" y="2" width="96" height="96" rx="26" stroke="#CBD5E1" stroke-width="2"/>

  <!-- Letra Psi (Ψ) y Cruz Médica -->
  <path
    d="M 26 34
       C 26 58, 40 68, 50 68
       C 60 68, 74 58, 74 34"
    fill="none"
    stroke="url(#favEmerald)"
    stroke-width="7"
    stroke-linecap="round"
  />

  <path
    d="M 50 20
       L 50 80"
    fill="none"
    stroke="url(#favNavy)"
    stroke-width="7"
    stroke-linecap="round"
  />

  <path
    d="M 36 49
       L 64 49"
    fill="none"
    stroke="url(#favNavy)"
    stroke-width="5.5"
    stroke-linecap="round"
  />

  <circle cx="50" cy="20" r="5" fill="#0F766E"/>
</svg>