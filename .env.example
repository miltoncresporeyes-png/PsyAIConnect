# =============================================
# PsyConnect - Environment Variables
# =============================================
# Copiar este archivo a .env y completar los valores

# ----- Base de Datos -----
# PostgreSQL connection string (Supabase / RDS recomendado)
# DATABASE_URL: URL con pooling de transacciones (PgBouncer) para la aplicación en runtime.
# Debe incluir ?pgbouncer=true&connection_limit=15 para evitar agotar conexiones.
DATABASE_URL="postgresql://postgres.[PROJECT]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=15"
# DIRECT_URL: URL directa (puerto 5432) usada exclusivamente por Prisma Migrate (prisma migrate deploy).
DIRECT_URL="postgresql://postgres.[PROJECT]:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"

# ----- NextAuth -----
# Secreto para firmar JWTs (generar con: openssl rand -base64 32)
NEXTAUTH_SECRET="tu-secreto-super-seguro-de-al-menos-32-caracteres"

# URL de la aplicación (sin slash final)
NEXTAUTH_URL="http://localhost:3000"

# ----- Google OAuth -----
# Configurar en: https://console.cloud.google.com
# APIs & Services > Credentials > Create OAuth Client ID
GOOGLE_CLIENT_ID="xxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="xxxxx"

# ----- Cifrado de Ficha Clínica (Envelope v1 con KeyRing) -----
# Clave primaria activa (exactamente 64 caracteres hex: 32 bytes AES-256-GCM)
# Generar con: openssl rand -hex 32
ENCRYPTION_KEY="64-caracteres-hexadecimales-generados-con-openssl"

# Identificador de la clave activa primaria (por defecto: k1)
ENCRYPTION_KID="k1"

# Diccionario JSON opcional para rotación de claves sin pérdida de datos históricos.
# Permite descifrar registros antiguos cifrados con claves previas:
# ENCRYPTION_KEYS='{"k1":"clave_hex_antigua_64","k2":"clave_hex_nueva_64"}'
ENCRYPTION_KEYS=""

# Secreto para HMAC de notas clinicas / firmas clinicas (>= 32 caracteres)
# Generar con: openssl rand -hex 32
# Obligatorio en produccion; sin el, las firmas clinicas no se pueden verificar.
CLINICAL_HASH_SECRET=""

# URL publica de la aplicacion (sin slash final). Usada en emails transaccionales
# (verificacion de correo, reset de contrasena). En Vercel: https://tu-dominio.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ----- Flow.cl (Pagos) -----
# Configurar cuando se integre pagos reales
# FLOW_API_KEY=""
# FLOW_SECRET_KEY=""

# ----- Mercado Pago -----
# Obtener Access Token en: https://www.mercadopago.cl/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=""

# ----- Transbank Webpay Plus -----
# Por defecto usa credenciales públicas oficiales de prueba (Sandbox/Integración)
TRANSBANK_COMMERCE_CODE="597055555532"
TRANSBANK_API_KEY="579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C"
TRANSBANK_ENVIRONMENT="integration"

# ----- PayPal -----
# Obtener credenciales en: https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENVIRONMENT="sandbox"
PAYPAL_USD_EXCHANGE_RATE="950"

# ----- Email (Resend) -----
# Servicio recomendado: https://resend.com
# Crear cuenta y obtener API Key
# Sin esta variable, los emails se muestran en consola (modo desarrollo)
RESEND_API_KEY=""
EMAIL_FROM="PsyDoctor <noreply@psydoctor.cl>"

# ----- Modo de ejecución -----
NODE_ENV="development"

# ----- Seguridad de Seeds (solo dev/staging) -----
# Requerida para ejecutar /api/seed mediante header x-seed-key
SEED_API_KEY="cambia-esto-por-un-valor-largo-y-aleatorio"

# ----- Observabilidad / Alertas -----
# Webhook para alertas operativas (Slack, Teams, etc.)
OPS_ALERT_WEBHOOK_URL=""

# ----- Supabase (Realtime) -----
# Configurar para tiempo real en salas de espera
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ----- Sentry (Monitoreo y Error Tracking) -----
# Registrarse en: https://sentry.io
# Crear proyecto Next.js y copiar el DSN
NEXT_PUBLIC_SENTRY_DSN=""

# ----- Respaldo Automático -----
# Configurar para notificaciones de backup (Slack/Discord)
SLACK_WEBHOOK_URL=""

# ----- OpenAI (Asistente PsyAI 24/7) -----
# Obtener API key en: https://platform.openai.com/api-keys
# Modelo: gpt-4o-mini (rápido, económico, ideal para asistentes)
OPENAI_API_KEY="sk-..."

# ----- Daily.co (Videollamada) -----
# Registrarse en: https://daily.co
# Crear cuenta y obtener API Key
DAILY_API_KEY=""

# ----- SII / Lioren (Facturación Electrónica) -----
# Webhook secret para verificar firmas de SII
SII_WEBHOOK_SECRET=""
# URL del webhook para configurar en Lioren/SII
SII_WEBHOOK_URL="https://tu-dominio.com/api/sii/webhook"
