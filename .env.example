# =============================================
# PsyConnect - Environment Variables
# =============================================
# Copiar este archivo a .env y completar los valores

# ----- Base de Datos -----
# PostgreSQL connection string (Supabase recomendado)
# DATABASE_URL: Usa la URL con pooling para la app
DATABASE_URL="postgresql://postgres.[PROJECT]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: Usa la URL directa para migraciones de Prisma
DIRECT_URL="postgresql://postgres.[PROJECT]:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"

# ----- NextAuth -----
# Secreto para firmar JWTs (generar con: openssl rand -base64 32)
NEXTAUTH_SECRET="tu-secreto-super-seguro-de-al-menos-32-caracteres"

# URL de la aplicación (sin slash final)
NEXTAUTH_URL="http://localhost:3000"

# ----- Google OAuth -----
# Configurar en: https://console.cloud.google.com
# APIs & Services > Credentials > Create OAuth Client ID
GOOGLE_CLIENT_ID="xxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="xxxxx"

# ----- Cifrado -----
# Clave para cifrar notas clínicas (generar con: openssl rand -hex 32)
# IMPORTANTE: Guardar en lugar seguro. Si se pierde, las notas no se pueden descifrar.
ENCRYPTION_KEY="64-caracteres-hexadecimales-generados-con-openssl"

# ----- Flow.cl (Pagos) -----
# Configurar cuando se integre pagos reales
# FLOW_API_KEY=""
# FLOW_SECRET_KEY=""

# ----- Email (Resend) -----
# Servicio recomendado: https://resend.com
# Crear cuenta y obtener API Key
# Sin esta variable, los emails se muestran en consola (modo desarrollo)
RESEND_API_KEY=""
EMAIL_FROM="PsyDoctor <noreply@psydoctor.cl>"

# ----- Modo de ejecución -----
NODE_ENV="development"

# ----- Seguridad de Seeds (solo dev/staging) -----
# Requerida para ejecutar /api/seed mediante header x-seed-key
SEED_API_KEY="cambia-esto-por-un-valor-largo-y-aleatorio"

# ----- Observabilidad / Alertas -----
# Webhook para alertas operativas (Slack, Teams, etc.)
OPS_ALERT_WEBHOOK_URL=""

# ----- Supabase (Realtime) -----
# Configurar para tiempo real en salas de espera
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ----- Sentry (Monitoreo y Error Tracking) -----
# Registrarse en: https://sentry.io
# Crear proyecto Next.js y copiar el DSN
NEXT_PUBLIC_SENTRY_DSN=""

# ----- Respaldo Automático -----
# Configurar para notificaciones de backup (Slack/Discord)
SLACK_WEBHOOK_URL=""

# ----- Daily.co (Videollamada) -----
# Registrarse en: https://daily.co
# Crear cuenta y obtener API Key
DAILY_API_KEY=""

# ----- SII / Lioren (Facturación Electrónica) -----
# Webhook secret para verificar firmas de SII
SII_WEBHOOK_SECRET=""
# URL del webhook para configurar en Lioren/SII
SII_WEBHOOK_URL="https://tu-dominio.com/api/sii/webhook"
